<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoxfortNeptun.Views.AddStudentToClassPage"
             Title="Add Student to Class">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Add student to class" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />

            <Label Text="Class name" />
            <Entry x:Name="ClassNameEntry" Placeholder="Enter class name" />

            <Label Text="Student Neptun code" />
            <Entry x:Name="NeptunEntry" Placeholder="e.g. HPOTTR" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Save" Clicked="OnSaveClicked" />
                <Button Text="Cancel" Clicked="OnCancelClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>