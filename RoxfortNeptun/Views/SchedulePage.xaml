<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoxfortNeptun.Views.SchedulePage"
             Title="Schedule">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New Class" IsEnabled="{Binding IsTeacher}"/>
        <ToolbarItem Text="Add Student to Class" IsEnabled="{Binding IsTeacher}"/>
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <CollectionView x:Name="TasksCollectionView" ItemsSource="{Binding ClassTasks}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="8" Padding="10" CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Place}" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding StartTimeDisplay}" />
                                <Label Text="–" />
                                <Label Text="{Binding EndTimeDisplay}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage.Content>
</ContentPage>