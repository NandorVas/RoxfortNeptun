<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoxfortNeptun.Views.SchedulePage"
             Title="Schedule">

    <RefreshView Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Tasks}" EmptyView="No tasks">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="6" HasShadow="True">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Place}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding StartTime}" />
                                <Label Text="–" />
                                <Label Text="{Binding EndTime}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>