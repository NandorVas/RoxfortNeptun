<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoxfortNeptun.Views.ProfilPage"
             Title="Profil">
    <VerticalStackLayout Padding="20" Spacing="8">
        <Label Text="Current student:" FontAttributes="Bold"/>
        <!-- Use BaseViewModel.Name (kept in sync with AuthService.CurrentUser) -->
        <Label Text="{Binding Name}" FontSize="24"/>
        <Label Text="{Binding DatabaseInfo}" FontSize="12" TextColor="Gray"/>

        <!-- Use the inherited LogoutCommand from BaseViewModel -->
        <Button Text="Log Out"
                Command="{Binding LogoutCommand}"
                IsVisible="{Binding IsLoggedIn}"/>
    </VerticalStackLayout>
</ContentPage>