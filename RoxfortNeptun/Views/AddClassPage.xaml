<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoxfortNeptun.Views.AddClassPage"
             Title="Add Class">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Add new class" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />

            <Label Text="Name" />
            <Entry x:Name="NameEntry" Placeholder="Class name" />

            <Label Text="Number of students" />
            <Entry x:Name="NumOfStudsEntry" Placeholder="e.g. 20" Keyboard="Numeric" />

            <Label Text="Place / Room" />
            <Entry x:Name="PlaceEntry" Placeholder="Room, e.g. B012" />

            <HorizontalStackLayout VerticalOptions="Center" Spacing="10">
                <Label Text="Is class?" VerticalOptions="Center" />
                <Switch x:Name="IsClassSwitch" IsToggled="True" />
            </HorizontalStackLayout>

            <Label Text="Start time" />
            <TimePicker x:Name="StartTimePicker" Time="09:00:00" />

            <Label Text="End time" />
            <TimePicker x:Name="EndTimePicker" Time="10:00:00" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Button Text="Save" x:Name="SaveButton" Clicked="OnSaveClicked" />
                <Button Text="Cancel" x:Name="CancelButton" Clicked="OnCancelClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>