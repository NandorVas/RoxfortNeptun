<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoxfortNeptun.Views.TaskPage"
             Title="Tasks">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Button Text="Pick and Share File" Clicked="OnShareFileClicked" />
        <Label x:Name="FileNameLabel" Text="No file selected" />
    </VerticalStackLayout>
</ContentPage>